EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

EXPO_PUBLIC_FEATURE_MESSAGES=true
EXPO_PUBLIC_FEATURE_NOTIFICATIONS=true
EXPO_PUBLIC_FEATURE_PRESENCE=true

# Public token used by the app at runtime.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token
# Build secret used for native iOS/Android builds.
MAPBOX_DOWNLOADS_TOKEN=sk.your-mapbox-downloads-token
